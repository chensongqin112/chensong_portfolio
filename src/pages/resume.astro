---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';

const resumeUrl = '/resume.pdf';
const hasResume = existsSync(join(process.cwd(), 'public', 'resume.pdf'));
---

<Base title="Resume" description="Resume of Chen-Song Qin." wide>
	{
		hasResume ? (
			<>
				<iframe class="resume-frame" src={resumeUrl} title="Resume"></iframe>
				<p class="resume-link">
					<a href={resumeUrl}>Open the PDF</a>
				</p>
			</>
		) : (
			<div class="resume-frame resume-placeholder">
				<p>Place the resume PDF at <code>public/resume.pdf</code>.</p>
			</div>
		)
	}
</Base>
